<div class="container mt-4">
    <div class="row">
        <!-- Sepet Ürünleri -->
        <div class="col-10">
            <div class="card p-3">
                <h2 class="mb-3">Sepetteki Ürünler</h2>
                <div class="cart-item d-flex justify-content-between align-items-center border-bottom py-2">
                    <img src="https://via.placeholder.com/50" alt="Ürün Resmi" class="img-fluid me-3">
                    <span>Ürün 1</span>
                    <span>100 TL</span>
                    <div class="quantity d-flex align-items-center">
                        <button class="btn btn-outline-secondary btn-sm" onclick="decreaseQuantity(this)">-</button>
                        <input type="text" class="form-control text-center mx-2" value="1" readonly style="width: 50px;">
                        <button class="btn btn-outline-secondary btn-sm" onclick="increaseQuantity(this)">+</button>
                    </div>
                    <button class="btn btn-danger btn-sm" onclick="removeItem(this)"><i class="fas fa-trash"></i></button>
                </div>
                <div class="cart-item d-flex justify-content-between align-items-center border-bottom py-2">
                    <img src="https://via.placeholder.com/50" alt="Ürün Resmi" class="img-fluid me-3">
                    <span>Ürün 2</span>
                    <span>150 TL</span>
                    <div class="quantity d-flex align-items-center">
                        <button class="btn btn-outline-secondary btn-sm" onclick="decreaseQuantity(this)">-</button>
                        <input type="text" class="form-control text-center mx-2" value="1" readonly style="width: 50px;">
                        <button class="btn btn-outline-secondary btn-sm" onclick="increaseQuantity(this)">+</button>
                    </div>
                    <button class="btn btn-danger btn-sm" onclick="removeItem(this)"><i class="fas fa-trash"></i></button>
                </div>
                <div class="cart-item d-flex justify-content-between align-items-center border-bottom py-2">
                    <img src="https://via.placeholder.com/50" alt="Ürün Resmi" class="img-fluid me-3">
                    <span>Ürün 3</span>
                    <span>200 TL</span>
                    <div class="quantity d-flex align-items-center">
                        <button class="btn btn-outline-secondary btn-sm" onclick="decreaseQuantity(this)">-</button>
                        <input type="text" class="form-control text-center mx-2" value="1" readonly style="width: 50px;">
                        <button class="btn btn-outline-secondary btn-sm" onclick="increaseQuantity(this)">+</button>
                    </div>
                    <button class="btn btn-danger btn-sm" onclick="removeItem(this)"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>

        <!-- Sipariş Özeti -->
        <div class="col-2">
            <div class="card p-3">
                <h4 class="mb-3">Sipariş Özeti</h4>
                <p>Ara Toplam: <span id="subtotal">0</span> TL</p>
                <p>KDV: <span id="tax">0</span> TL</p>
                <p><strong>Toplam: <span id="total">0</span> TL</strong></p>
                <a href="/Order/Delivery" class="btn btn-outline-primary">Sepeti Onayla</a>

            </div>
        </div>
    </div>
</div>

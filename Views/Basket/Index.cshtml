@using ecommerce.Models.View
@model BasketViewModel 

<div class="container mt-4">
    <div class="row">
        <!-- Sepet Ürünleri -->
        <div class="col-10">
            <div class="card p-3">
                <h2 class="mb-3">Sepetteki Ürünler</h2>
                @foreach (basket item in ViewBag.basket)
                {
                    <div class="cart-item d-flex justify-content-between align-items-center border-bottom py-2">
                        <img src="@item.image_url" alt="Ürün Resmi" class="img-fluid me-3">
                        <span>@item.product_name</span>
                        <span>@item.amount.ToString("0.00") TL</span>
                        <div class="quantity d-flex align-items-center">
                            <button class="btn btn-outline-secondary btn-sm" onclick="decreaseQuantity(this)">-</button>
                            <input type="text" class="form-control text-center mx-2" value="@item.quantity" readonly style="width: 50px;">
                            <button class="btn btn-outline-secondary btn-sm" onclick="increaseQuantity(this)">+</button>
                        </div>
                        <button class="btn btn-danger btn-sm" onclick="removeItem(this)"><i class="fas fa-trash"></i></button>
                    </div>
                }
            </div>
        </div>

        <!-- Sipariş Özeti -->
       @*  <div class="col-2">
            <div class="card p-3">
                <h4 class="mb-3">Sipariş Özeti</h4>
                <p>Ara Toplam: <span id="subtotal">@Model.Sum(x => x.amount * x.quantity).ToString("0.00")</span> TL</p>
                <p>KDV: <span id="tax">0</span> TL</p>
                <p><strong>Toplam: <span id="total">@Model.Sum(x => x.Price * x.Quantity).ToString("0.00")</span> TL</strong></p>
                <a href="/Order/Delivery" class="btn btn-outline-primary">Sepeti Onayla</a>
            </div>
        </div> *@
    </div>
</div>

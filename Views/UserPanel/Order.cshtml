<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="container  d-flex justify-content-center mt-3">
                @await Component.InvokeAsync("UserPanel")
            </div>
        </div>

        <div id="siparis" class="col-md-9">
            <div class="card shadow-sm bg-white p-4">
                <h3 class="card-title"> Siparişlerim</h3>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sipariş id</th>
                                <th>Ürün</th>
                                <th>Fiyat</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (ViewBag.orders != null)
                            {
                                @foreach (order item in ViewBag.orders)
                                {
                                    <tr>
                                        <td>@item.id</td>
                                        <td>@item.product.name</td>
                                        <td>@item.product.price.ToString("N2") TL</td>
                                        <td>Kargoda</td> @* döngüyle yazılacak. *@
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

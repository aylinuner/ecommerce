<div class="container mt-4">
    <div class="row">
        <!-- Sol taraf: Filtreleme -->
        <div class="col-md-3">
            <h4>Filtreleme</h4>
            <form method="get" action="@Url.Action("Index", "Product")">

                <!-- Kategori Filtreleme -->
                <div class="form-group">
                    <h5>Kategori</h5>
                    <div class="filter-box">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Notebook" id="notebook">
                            <label class="form-check-label" for="notebook">Notebook</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Notebook" id="notebook">
                            <label class="form-check-label" for="notebook">Notebook</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Notebook" id="notebook">
                            <label class="form-check-label" for="notebook">Notebook</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Notebook" id="notebook">
                            <label class="form-check-label" for="notebook">Notebook</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Notebook" id="notebook">
                            <label class="form-check-label" for="notebook">Notebook</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Notebook" id="notebook">
                            <label class="form-check-label" for="notebook">Notebook</label>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="category" value="Notebook" id="notebook">
                                <label class="form-check-label" for="notebook">Notebook</label>
                            </div>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Tablet" id="tablet">
                            <label class="form-check-label" for="tablet">Tablet</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Telefon" id="telefon">
                            <label class="form-check-label" for="telefon">Telefon</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="category" value="Masaüstü" id="masaustu">
                            <label class="form-check-label" for="masaustu">Masaüstü Bilgisayar</label>
                        </div>
                    </div>
                </div>

                <!-- Marka Filtreleme -->
                <div class="form-group mt-3">
                    <h5>Marka</h5>
                    <div class="filter-box">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="brand" value="Apple" id="apple">
                            <label class="form-check-label" for="apple">Apple</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="brand" value="Samsung" id="samsung">
                            <label class="form-check-label" for="samsung">Samsung</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="brand" value="Asus" id="asus">
                            <label class="form-check-label" for="asus">Asus</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="brand" value="Dell" id="dell">
                            <label class="form-check-label" for="dell">Dell</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="brand" value="Lenovo" id="lenovo">
                            <label class="form-check-label" for="lenovo">Lenovo</label>
                        </div>
                    </div>
                </div>

                <!-- Fiyat Aralığı Filtreleme -->
                <div class="form-group mt-3">
                    <h5>Fiyat Aralığı</h5>
                    <div class="filter-box">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="price" value="0-5000" id="price1">
                            <label class="form-check-label" for="price1">0 - 5000 TL</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="price" value="5000-10000" id="price2">
                            <label class="form-check-label" for="price2">5000 - 10000 TL</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="price" value="10000-20000" id="price3">
                            <label class="form-check-label" for="price3">10.000 - 20.000 TL</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="price" value="20000-50000" id="price4">
                            <label class="form-check-label" for="price4">20.000 - 50.000 TL</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="price" value="20000-50000" id="price4">
                            <label class="form-check-label" for="price4">20.000 - 50.000 TL</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="price" value="20000-50000" id="price4">
                            <label class="form-check-label" for="price4">20.000 - 50.000 TL</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="price" value="20000-50000" id="price4">
                            <label class="form-check-label" for="price4">20.000 - 50.000 TL</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="price" value="20000-50000" id="price4">
                            <label class="form-check-label" for="price4">20.000 - 50.000 TL</label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-3">Filtrele</button>
            </form>
        </div>

        <!-- Sağ taraf: Ürün listesi -->
        <div class="col-md-9">
            <div class="row">
                @if (ViewBag.products != null)
                {

                    @foreach (product item in ViewBag.products)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card">
                                <img src="@item.image_url" class="card-img-top" alt="@item.name">
                                <div class="card-body">
                                    <h5 class="card-title">@item.name</h5>
                                    <p class="card-text">@item.description</p>
                                    <p class="text-primary fw-bold">@item.price</p>
                                    <a href="@Url.Action("Index", "ProductDetail", new { id =item.id })" class="btn btn-outline-primary">Ürüne git</a>
                                </div>
                            </div>
                        </div>
                    }
                }

            </div>
        </div>
    </div>
</div>
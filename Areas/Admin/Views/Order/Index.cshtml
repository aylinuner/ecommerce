@using ecommerce.Areas.Admin.Models
<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Kullanıcı id</th>
            <th>Sipariş id</th>
            <th>Toplam Mİktar</th>
            <th>Ödeme şekli</th>
            <th>Teslimat adresi</th>
            <th>Yüklenme tarihi</th>
            <th>Ödeme Tarihi</th>
            <th>Oluşturulma Tarihi</th>
            <th>Güncellenme Tarihi</th>
            <th class="text-center">
                @Html.ActionLink("Yeni", "Save", "Order", null, new { @class = "btn btn-primary" })
            </th>


        </tr>
    </thead>
    <tbody>
        @*   ViewBag içinde ürünler varsa *@
        @if (ViewBag.orders != null)
        {
            @*  ViewBag'daki ürünler içerisinde dön' *@
            foreach (order item in ViewBag.orders)
            {
                <tr>
                    <td class="">@item.order_id</td>
                    <td class="">@item.user_id</td>
                    <td class="">@item.total_amount</td>
                    <td class="">@item.payment_status</td>
                    <td class="">@item.delivery_adress</td>
                    <td class="">@item.upload_date</td>
                    <td class="">@item.payment_date</td>
                    <td class="">@item.create_date</td>
                    <td class="">@item.update_date</td>
                    <td style="width:90px">
                        @Html.ActionLink("Güncelle", "Save", "Order", new { id = item.id }, new { @class = "btn btn-primary" })
                    </td>
                </tr>
            }
        }
    </tbody>
</table>














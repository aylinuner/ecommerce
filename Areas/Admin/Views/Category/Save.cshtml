@using ecommerce.Areas.Admin.Models.View
@model CategoryViewModel
<div class="container mt-5">
    <h2 class="mb-4">Ürün Ekle</h2>
    <form method="post" action="/Admin/Category/Save">
        <div class="mb-3 row">
            <label for="name" class="col-sm-2 col-form-label">Ürün Adı:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="name" placeholder="Ürün adını girin" asp-for="name">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="sort_no" class="col-sm-2 col-form-label">Sıra numarası</label>
            <div class="col-sm-10">
                <input type="number" class="form-control" id="sort_no" placeholder="Sıra numarası girin" asp-for="sort_no">
            </div>
        </div>

      
        <div class="mb-3 row">
            <div class="col-sm-10 offset-sm-2">

                 @Html.ActionLink("Geri", "Index", "Category", null, new { @class = "btn btn-dark text-white" }) 
                @* Silme butonu denemek için koydum...*@
                @if (Model.id != 0)
                {

                     @Html.ActionLink("Sil", "Delete", "Category", new { id = Model.id }, new { @class = "btn btn-danger" }) 

                }
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </form>
</div>

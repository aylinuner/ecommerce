@using ecommerce.Areas.Admin.Models
<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            
            <th>Adı</th>
            <th>Sıra Numarası</th>
            <th>Güncellenme Tarihi</th>
            <th>Oluşturulma Tarihi</th>
            <th class="text-center">
                @Html.ActionLink("Yeni", "Save", "Category", null, new { @class = "btn btn-primary" })
            </th>


        </tr>
    </thead>
    <tbody>
        @*   ViewBag içinde kategoriler varsa *@
        @if (ViewBag.categories != null)
        {
            @*  ViewBag'daki kategoriler içerisinde dön' *@
            foreach (category item in ViewBag.categories)
            {
                <tr>
                    <td class="">@item.name</td>
                    <td class="">@item.sort_no</td>
                    @* <td class="">@item.category_name</td> *@
                    <td class="">@item.update_date</td>
                    <td class="">@item.create_date</td>
                    <td style="width:90px">
                        @Html.ActionLink("Güncelle", "Save", "Category", new { id = item.id }, new { @class = "btn btn-primary" })
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
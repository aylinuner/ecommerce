@using ecommerce.Areas.Admin.Models.View
@model EntryViewModel

<div class="container mt-5">
    <h2 class="mb-4">Stok Giriş</h2>
    <form method="post" action="/Admin/Entry/Save">
        <div class="mb-3 row">
            <label for="waybill_no" class="col-sm-2 col-form-label">İrsaliye No:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="waybill_no" placeholder="İrsaliye no girin" asp-for="waybill_no">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_date" class="col-sm-2 col-form-label">İrsaliye Tarihi:</label>
            <div class="col-sm-10">
                <input type="date" class="form-control" id="waybill_date" asp-for="waybill_date">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="supplier_id" class="col-sm-2 col-form-label">Tedarikçi Firma:</label>
            <div class="col-sm-10">
                <select class="form-control" id="supplier_id" asp-for="supplier_id">
                    <option value="">Seçiniz</option>
                    @foreach (var supplier in ViewBag.suppliers ?? new List<SelectListItem>())
                    {
                        <option value="@supplier.Value">@supplier.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_total" class="col-sm-2 col-form-label">İrsaliye Tutarı</label>
            <div class="col-sm-10">
                <input type="number" step="0.01" class="form-control" id="waybill_total" placeholder="İrsaliye tutarını girin" asp-for="waybill_total">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="receiver_id" class="col-sm-2 col-form-label">Teslim Alan Kişi</label>
            <div class="col-sm-10">
                <select class="form-control" id="receiver_id" asp-for="receiver_id">
                    <option value="">Seçiniz</option>
                    @foreach (var user in ViewBag.users ?? new List<SelectListItem>())
                    {
                        <option value="@user.Value">@user.Text</option>
                    }
                </select>
            </div>
        </div>

        <hr />

        <table class="table table-striped table-bordered mt-3" id="productTable">
            <thead class="table-dark">
                <tr>
                    <th>Ürün Adı</th>
                    <th>Adet</th>
                    <th>Tutar</th>
                    <th>Toplam Tutar</th>
                    <th>Ağırlık</th>

                </tr>
            </thead>
            <tbody id="entryDetailsBody">

                @foreach (var item in Model.entry_details)
                {
                    <tr class="entry-row" data-id="@item.id">
                        <td class="" >@item.product.name</td>
                        <td class="" id="quantity" asp-for="quantity">@item.quantity</td>
                        <td class="">@item.total</td>
                        <td class="">@item.total_amount</td>
                        <td class="">@item.weight</td>

                    </tr>
                }
            </tbody>

        </table>
        <div class="mb-3 row">
            <div class="col-sm-10 offset-sm-2">
                @Html.ActionLink("Geri", "Index", "Entry", new { area = "Admin" }, new { @class = "btn btn-dark text-white" })
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#productModal">
                    Yeni Ürün Ekle
                </button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </form>
</div>

<!-- Ürün Ekle Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Ürün Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body ">
                <form id="productForm">
                    <div class="mb-3">
                        <label class="form-label">Ürün</label>
                        <select class="form-control" id="product_id">
                            <option value="">Ürün Seçiniz</option>
                            @foreach (var product in ViewBag.products ?? new List<SelectListItem>())
                            {
                                <option value="@product.Value">@product.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adet</label>
                        <input type="number" class="form-control" id="quantity" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Birim Fiyat</label>
                        <input type="number" step="0.01" class="form-control" id="amount" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ağırlık</label>
                        <input type="number" step="0.01" class="form-control" id="weight" required>
                    </div>
                    <button type="button" class="btn btn-success" onclick="addProductToTable()">Ekle</button>
                    <button type="button" class="btn btn-danger" onclick="RemoveProductToTable()">Sİl</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function(){
        document.querySelectorAll(".entry-row").forEach(row=>{
            row.addEventListener("dbclick", function(){
                var entryId = this.getAttribute("data-id");
                window.location.href = "/Admin/Entry/Save?id=" +entryId;

            });
        });
    });

    //Modal güncelleme yeri. productModal yukarıda oluşturuldu, updateModal oluşturulacak


           document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".entry-row").forEach(row => {
            row.addEventListener("dblclick", function () {
                // Güncelleme modalını aç
                var updateModal = new bootstrap.Modal(document.getElementById("updateModal"));
                updateModal.show();

                // Satırdan verileri al
                var entryId = this.getAttribute("data-id");
                var productName = this.children[0].innerText; // 1. sütun (Ürün Adı)
                var quantity = this.children[1].innerText; // 2. sütun (Adet)
                var total = this.children[2].innerText; // 3. sütun (Toplam)
                var totalAmount = this.children[3].innerText; // 4. sütun (Toplam Tutar)
                var weight = this.children[4].innerText; // 5. sütun (Ağırlık)

                // Modal içindeki inputlara verileri doldur
                document.getElementById("update_id").value = entryId;
                document.getElementById("update_product_name").value = productName;
                document.getElementById("update_quantity").value = quantity;
                document.getElementById("update_total").value = total;
                document.getElementById("update_total_amount").value = totalAmount;
                document.getElementById("update_weight").value = weight;
            });
        });
    });

        function addProductToTable() {
        let product = document.getElementById("product_id");
        let quantity = document.getElementById("quantity").value;
        let amount = document.getElementById("amount").value;
        let total_amount = (quantity * amount).toFixed(2);
        let weight = document.getElementById("weight").value;

        let tableBody = document.getElementById("entryDetailsBody");
        let newRow = `
            <tr>
                <td>${product.options[product.selectedIndex].text}</td>
                <td>${quantity}</td>
                <td>${amount}</td>
                <td>${total_amount}</td>
                <td>${weight}</td>
                <td><button type="button" class="btn btn-danger" onclick="removeRow(this)">Sil</button></td>
            </tr>
        `;
        tableBody.insertAdjacentHTML("beforeend", newRow);

        document.getElementById("productForm").reset();
        bootstrap.Modal.getInstance(document.getElementById('productModal')).hide();
    }

    function removeRow(button) {
        button.closest("tr").remove();
    }
</script>

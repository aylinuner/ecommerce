@using ecommerce.Areas.Admin.Models.View
@model EntryViewModel
<div class="container mt-5">
    <h2 class="mb-4">Stok Giriş</h2>
    <form method="post" action="/Admin/Entry/Save">
        <div class="mb-3 row">
            <label for="waybill_name" class="col-sm-2 col-form-label">İrsaliye No:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="waybill_name" placeholder="İrsaliye no girin" asp-for="waybill_no">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_date" class="col-sm-2 col-form-label">İrsaliye Tarihi:</label>
            <div class="col-sm-10">
                <input type="date" class="form-control" id="waybill_date" asp-for="waybill_date">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="supplier_id" class="col-sm-2 col-form-label">Tedarikçi Firma:</label>
            <div class="col-sm-10">
                @* <input type="text" class="form-control" id="supplier_id" asp-for="supplier_id" > *@
                <select class="form-control" id="supplier_id" asp-for="supplier_id">
                    <option value="">Seçiniz</option>
                    @if (ViewBag.suppliers != null)
                    {
                        foreach (var supplier in ViewBag.suppliers)
                        {
                            <option value="@supplier.Value">@supplier.Text</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_total" class="col-sm-2 col-form-label">İrsaliye Tutarı</label>
            <div class="col-sm-10">
                <input type="number" class="form-control" id="waybill_total" placeholder="İrsaliye tutarını girin" asp-for="waybill_total">
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-2 col-form-label">Teslim Alan Kişi</label>
            <div class="col-sm-10">
                <select class="form-control" id="receiver_id" asp-for="receiver_id">
                    <option value="">Seçiniz</option>
                    @if (ViewBag.users != null)
                    {
                        foreach (var user in ViewBag.users)
                        {
                            <option value="@user.Value">@user.Text</option>
                        }
                    }
                </select>
            </div>
        </div>

        <hr />

        <table class="table table-striped table-bordered mt-3" id="productTable">
            <thead class="table-dark">
                <tr>
                    <th>Ürün Adı</th>
                    <th>Adet</th>
                    <th>Tutar</th>
                    <th>Toplam Tutar</th>
                    <th>Ağırlık</th>
                    <th class="text-center">
                        <button id="addRowBtn" class="btn btn-primary">Yeni</button>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr id="inputRow">
                    <td><input type="text" id="productId" placeholder="Ürün Adı" /></td>
                    <td><input type="number" id="quantity" placeholder="Adet" /></td>
                    <td><input type="number" id="total" placeholder="Tutar" /></td>
                    <td><input type="number" id="totalAmount" placeholder="Toplam Tutar" /></td>
                    <td><input type="number" id="weight" placeholder="Ağırlık" /></td>
                </tr>
            </tbody>
        </table>

        <div class="mb-3 row">
            <div class="col-sm-10 offset-sm-2">


                @Html.ActionLink("Geri", "Index", "Entry", new { area = "Admin" }, new { @class = "btn btn-dark text-white" })

                @* Silme butonu *@
                @if (Model.id != 0)
                {
                    <button type="button" class="btn btn-danger" onclick="deleteEntry(@Model.id)">Sil</button>
                }
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </form>


    <script>
          document.getElementById('addRowBtn').addEventListener('click', function(e) {
            e.preventDefault();

            //Giriş değerlerini alın
            var productId = document.getElementById('productId').value;
            var quantity = document.getElementById('quantity').value;
            var total = document.getElementById('total').value;
            var totalAmount = document.getElementById('totalAmount').value;
            var weight = document.getElementById('weight').value;

            // Herhangi bir girdinin boş olup olmadığını kontrol edin
            if (productId && quantity && total && totalAmount && weight) {
                var table = document.getElementById('productTable').getElementsByTagName('tbody')[0];
                var newRow = table.insertRow(table.rows.length);

                newRow.innerHTML = `
                    <td>${productId}</td>
                    <td>${quantity}</td>
                    <td>${total}</td>
                    <td>${totalAmount}</td>
                    <td>${weight}</td>
                    <td><button class="btn btn-primary">Güncelle</button></td>
                `;

                // Satırı ekledikten sonra giriş alanlarını temizleyin
                document.getElementById('productId').value = '';
                document.getElementById('quantity').value = '';
                document.getElementById('total').value = '';
                document.getElementById('totalAmount').value = '';
                document.getElementById('weight').value = '';
            } else {
                alert("Lütfen tüm alanları doldurun.");
            }
        });


        function deleteEntry(id) {
            if (confirm('Bu kaydı silmek istediğinize emin misiniz?')) {
                fetch(`/Admin/Entry/Delete/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert("Kayıt başarıyla silindi.");
                        window.location.href = "/Admin/Entry/Index"; // Silme işlemi sonrası listeye yönlendirme
                    } else {
                        alert("Silme işlemi başarısız.");
                    }
                })
                .catch(error => {
                    console.error("Hata:", error);
                    alert("Bir hata oluştu.");
                });
            }
        }
    </script>


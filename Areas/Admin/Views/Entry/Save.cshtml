@using ecommerce.Areas.Admin.Models.View
@model EntryViewModel

<div class="container mt-5">
    <h2 class="mb-4">Stok Giriş</h2>
    <form method="post" action="/Admin/Entry/Save">
        <input type="text" id="id" asp-for="id" hidden>
        <div class="mb-3 row">
            <label for="waybill_no" class="col-sm-2 col-form-label">İrsaliye No:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="waybill_no" placeholder="İrsaliye no girin" asp-for="waybill_no">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_date" class="col-sm-2 col-form-label">İrsaliye Tarihi:</label>
            <div class="col-sm-10">
                <input type="date" class="form-control" id="waybill_date" asp-for="waybill_date">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="supplier_id" class="col-sm-2 col-form-label">Tedarikçi Firma:</label>
            <div class="col-sm-10">
                <select class="form-control" id="supplier_id" asp-for="supplier_id">
                    <option value="">Seçiniz</option>
                    @foreach (var supplier in ViewBag.suppliers ?? new List<SelectListItem>())
                    {
                        <option value="@supplier.Value">@supplier.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_total" class="col-sm-2 col-form-label">İrsaliye Tutarı</label>
            <div class="col-sm-10">
                <input type="number" step="0.01" class="form-control" id="waybill_total" placeholder="İrsaliye tutarını girin" asp-for="waybill_total">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="receiver_id" class="col-sm-2 col-form-label">Teslim Alan Kişi</label>
            <div class="col-sm-10">
                <select class="form-control" id="receiver_id" asp-for="receiver_id">
                    <option value="">Seçiniz</option>
                    @foreach (var user in ViewBag.users ?? new List<SelectListItem>())
                    {
                        <option value="@user.Value">@user.Text</option>
                    }
                </select>
            </div>
        </div>

        <hr />

        <table class="table table-striped table-bordered mt-3" id="productTable">
            <thead class="table-dark">
                <tr>
                    <th>Ürün Adı</th>
                    <th>Adet</th>
                    <th>Birim Fiyat</th>
                    <th>Toplam Tutar</th>
                    <th>Ağırlık</th>
                </tr>
            </thead>
            <tbody id="entryDetailsBody">
                @for (var i = 0; i < Model.entry_details.Count; i++)
                {
                    <tr data-id="@Model.id" ondblclick="openUpdateModal(this)">
                        <td>
                            @Model.entry_details[i].product.name
                            <input type="hidden" name="entry_details[@i].product_id" value="@Model.entry_details[i].product_id" />

                            <input type="hidden" name="entry_details[@i].id" value="@Model.entry_details[i].id" />
                        </td>

                        <td>
                            @Model.entry_details[i].quantity
                            <input type="hidden" name="entry_details[@i].quantity" value="@Model.entry_details[i].quantity" class="form-control" />
                        </td>
                        <td>
                            @Model.entry_details[i].amount
                            <input type="hidden" step="0.01" name="entry_details[@i].amount" value="@Model.entry_details[i].amount" class="form-control" />
                        </td>
                        <td>
                            @Model.entry_details[i].total_amount
                            <input type="hidden" step="0.01" name="entry_details[@i].total_amount" value="@Model.entry_details[i].total_amount" class="form-control" />
                        </td>
                        <td>
                            @Model.entry_details[i].weight
                            <input type="hidden" step="0.01" name="entry_details[@i].weight" value="@Model.entry_details[i].weight" class="form-control" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mb-3 row">
            <div class="col-sm-10 offset-sm-2">
                @Html.ActionLink("Geri", "Index", "Entry", new { area = "Admin" }, new { @class = "btn btn-dark text-white" })
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#productModal">
                    Yeni Ürün Ekle
                </button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </form>
</div>

<!-- Ürün Ekle Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Ürün Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body ">
                <form id="productForm">
                    <div class="mb-3">
                        <label class="form-label">Ürün</label>
                        <select class="form-control" id="product_id">
                            <option value="">Ürün Seçiniz</option>
                            @foreach (var product in ViewBag.products ?? new List<SelectListItem>())
                            {
                                <option value="@product.Value">@product.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adet</label>
                        <input type="number" class="form-control" id="quantity" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Birim Fiyat</label>
                        <input type="number" step="0.01" class="form-control" id="amount" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ağırlık</label>
                        <input type="number" step="0.01" class="form-control" id="weight" required>
                    </div>
                    <button type="button" class="btn btn-success" onclick="addProductToTable()">Ekle</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Güncelle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body ">
                <form id="updateForm">
                    <div class="mb-3">
                        <label class="form-label">Ürün</label>
                        <select class="form-control" id="update_id">
                            <option value="">Ürün Seçiniz</option>
                            @foreach (var product in ViewBag.products ?? new List<SelectListItem>())
                            {
                                <option value="@product.Value">@product.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adet</label>
                        <input type="number" class="form-control" id="update_quantity" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Birim Fiyat</label>
                        <input type="number" step="0.01" class="form-control" id="update_amount" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ağırlık</label>
                        <input type="number" step="0.01" class="form-control" id="update_weight" required>
                    </div>
                    <button type="button" class="btn btn-success" onclick="updateTable()">Güncelle</button>

                </form>
            </div>
        </div>
    </div>
</div>

<script>
        function addProductToTable() {
            let product = document.getElementById("product_id");
            let quantity = document.getElementById("quantity").value;
            let amount = document.getElementById("amount").value;
            let total_amount = (quantity * amount).toFixed(2);
            let weight = document.getElementById("weight").value;

            // Dinamik index için satır sayısını kontrol et
            let index = document.querySelectorAll("#entryDetailsBody tr").length;

            // Eğer ürün seçilmemişse uyarı ver
            // if (!product.value) {
            //     alert("Lütfen bir ürün seçin!");
            //     return;
            // }

            // Yeni satır ekle
            let newRow = `
    <tr>
    <td>
                        ${product.options[product.selectedIndex].text}
    <input type="hidden" name="entry_details[${index}].product_id" value="${product.value}" />
    </td>
    <td>
     <span>${quantity}</span>
    <input type="hidden" name="entry_details[${index}].quantity" value="${quantity}" class="form-control" />
    </td>
    <td>
     <span>${amount}</span>
    <input type="hidden" step="0.01" name="entry_details[${index}].total" value="${amount}" class="form-control" />
    </td>
    <td>
     <span>${total_amount}</span>
    <input type="hidden" step="0.01" name="entry_details[${index}].total_amount" value="${total_amount}" class="form-control" />
    </td>
    <td>
     <span>${weight}</span>
    <input type="hidden" step="0.01" name="entry_details[${index}].weight" value="${weight}" class="form-control" />
    </td>

    </tr>`;

            document.getElementById("entryDetailsBody").insertAdjacentHTML("beforeend", newRow);
            bootstrap.Modal.getInstance(document.getElementById('productModal')).hide();

            // Formu temizle
            document.getElementById("productForm").reset();
        }

            function openUpdateModal(row) {
        let product = row.cells[0].querySelector("input").value;
        let quantity = row.cells[1].querySelector("input").value;
        let amount = row.cells[2].querySelector("input").value;
        let total_amount = row.cells[3].querySelector("input").value;
        let weight = row.cells[4].querySelector("input").value;

        // Güncelleme modalındaki inputlara değerleri ata
        document.getElementById("update_id").value = product;
        document.getElementById("update_quantity").value = quantity;
        document.getElementById("update_amount").value = amount;
        document.getElementById("update_weight").value = weight;

        // Güncellenecek satırı sakla
        document.getElementById("updateModal").setAttribute("data-row-index", row.rowIndex);

        // Modalı aç
        var updateModal = new bootstrap.Modal(document.getElementById("updateModal"));
        updateModal.show();


    }
</script>
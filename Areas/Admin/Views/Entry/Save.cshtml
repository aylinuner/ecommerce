@using ecommerce.Areas.Admin.Models.View
@model EntryViewModel
<div class="container mt-5">
    <h2 class="mb-4">Stok Giriş</h2>
    <form method="post" action="/Admin/Entry/Save">
        <div class="mb-3 row">
            <label for="waybill_name" class="col-sm-2 col-form-label">İrsaliye No:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="waybill_name" placeholder="İrsaliye no girin" asp-for="waybill_no">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_date" class="col-sm-2 col-form-label">İrsaliye Tarihi:</label>
            <div class="col-sm-10">
                <input type="date" class="form-control" id="waybill_date" asp-for="waybill_date">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="supplier_id" class="col-sm-2 col-form-label">Tedarikçi Firma:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="supplier_id" asp-for="supplier_id" >
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_total" class="col-sm-2 col-form-label">İrsaliye Tutarı</label>
            <div class="col-sm-10">
                <input type="number" class="form-control" id="waybill_total" placeholder="İrsaliye tutarını girin" asp-for="waybill_total">
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-2 col-form-label">Teslim Alan Kişi</label>
            <div class="col-sm-10">
                <select>
                    <option value="value">-</option>
                    
                </select>
            </div>
        </div>

        <hr />

        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th></th>
                    <th>Ürün Adı</th>
                    <th>Adet</th>
                    <th>Tutar</th>
                    <th>Toplam Tutar</th>
                    <th>Ağırlık</th>
                    <th class="text-center">
                        @Html.ActionLink("Yeni", "Save", "Customer", null, new { @class = "btn btn-primary" })
                    </th>
            </thead>
            <tbody>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>

                @*   ViewBag içinde stok giriş varsa *@
                @if (ViewBag.entry_details != null)
                {
                    @*  ViewBag'daki stok giriş içerisinde dön' *@
                    foreach (entry_master item in ViewBag.entry_masters)
                    {
                        <tr>
                            <td class="">@item.waybill_no</td>
                            <td class="">@item.waybill_date</td>
                            <td class="">@item.waybill_total</td>
                            <td class="">@item.supplier_id</td>
                            <td style="width:90px">
                                @* @Html.ActionLink("Güncelle", "Save", "Entry", new { id = item.id }, new { @class = "btn btn-primary" }) *@
                                <a href="/Admin/Entry/Save/@item.id" class="btn btn-primary">Güncelle</a>


                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="mb-3 row">
            <div class="col-sm-10 offset-sm-2">
                <a href="/Admin/Entry/Index" class="btn btn-dark text-white">Geri</a>

                @* @Html.ActionLink("Geri", "Index", "Category", null, new { @class = "btn btn-dark text-white" }) *@
                @* Silme butonu *@
                @* @if (Model.id != 0) *@

                <a href="/Admin/Entry/Index" class="btn btn-danger">Sil</a>

                @* @Html.ActionLink("Sil", "Delete", "Category", new { id = Model.id }, new { @class = "btn btn-danger" }) *@


                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </form>
</div>

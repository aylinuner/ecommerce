@using ecommerce.Areas.Admin.Models.View
@model EntryViewModel

<div class="container mt-5">
    <h2 class="mb-4">Stok Giriş</h2>
    <form method="post" action="/Admin/Entry/Save">
        <div class="mb-3 row">
            <label for="waybill_no" class="col-sm-2 col-form-label">İrsaliye No:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="waybill_no" placeholder="İrsaliye no girin" asp-for="waybill_no">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_date" class="col-sm-2 col-form-label">İrsaliye Tarihi:</label>
            <div class="col-sm-10">
                <input type="date" class="form-control" id="waybill_date" asp-for="waybill_date">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="supplier_id" class="col-sm-2 col-form-label">Tedarikçi Firma:</label>
            <div class="col-sm-10">
                <select class="form-control" id="supplier_id" asp-for="supplier_id">
                    <option value="">Seçiniz</option>
                    @foreach (var supplier in ViewBag.suppliers ?? new List<SelectListItem>())
                    {
                        <option value="@supplier.Value">@supplier.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3 row">
            <label for="waybill_total" class="col-sm-2 col-form-label">İrsaliye Tutarı</label>
            <div class="col-sm-10">
                <input type="number" step="0.01" class="form-control" id="waybill_total" placeholder="İrsaliye tutarını girin" asp-for="waybill_total">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="receiver_id" class="col-sm-2 col-form-label">Teslim Alan Kişi</label>
            <div class="col-sm-10">
                <select class="form-control" id="receiver_id" asp-for="receiver_id">
                    <option value="">Seçiniz</option>
                    @foreach (var user in ViewBag.users ?? new List<SelectListItem>())
                    {
                        <option value="@user.Value">@user.Text</option>
                    }
                </select>
            </div>
        </div>

        <hr />

        <table class="table table-striped table-bordered mt-3" id="productTable">
            <thead class="table-dark">
                <tr>
                    <th>Ürün Adı</th>
                    <th>Adet</th>
                    <th>Tutar</th>
                    <th>Toplam Tutar</th>
                    <th>Ağırlık</th>
                    <th class="text-center">
                        <button id="addRowBtn" type="button" class="btn btn-primary">Yeni</button>
                    </th>
                </tr>
            </thead>
            <tbody id="entryDetailsBody">

                @foreach (var item in Model.entry_details)
                {
                    <tr>
                        <td class="">@item.product.name</td>
                        <td class="">@item.quantity</td>
                        <td class="">@item.total</td>
                        <td class="">@item.total_amount</td>
                        <td class="">@item.weight</td>
                        <td>
                            <button type="button" class="btn btn-danger" onclick="deleteEntryDetail(@item.id)">Sil</button>

                        </td>
                    </tr>

                }

            </tbody>

        </table>

        <div class="mb-3 row">
            <div class="col-sm-10 offset-sm-2">
                @Html.ActionLink("Geri", "Index", "Entry", new { area = "Admin" }, new { @class = "btn btn-dark text-white" })
                @if (Model.id != 0)
                {
                    <button type="button" class="btn btn-danger" onclick="deleteEntry(@Model.id)">Sil</button>
                }
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </form>
</div>

<script>
      function deleteEntry(id) {
                        if (confirm('Bu kaydı silmek istediğinize emin misiniz?')) {
                            fetch(`/Admin/Entry/Delete/${id}`, {
                                method: 'DELETE',
                                headers: {
                                    'Content-Type': 'application/json',
                                }
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    alert("Kayıt başarıyla silindi.");
                                    window.location.href = "/Admin/Entry/Index"; // Silme işlemi sonrası listeye yönlendirme
                                } else {
                                    alert("Silme işlemi başarısız.");
                                }
                            })
                            .catch(error => {
                                console.error("Hata:", error);
                                alert("Bir hata oluştu.");
                            });
                        }
                    }
                        // entry_details listesini JavaScript dizisi olarak tanımla
                        let entryDetailsList = @Html.Raw(Json.Serialize(Model.entry_details));
                       function deleteEntryDetail(index) {

                            if (confirm("Bu kaydı silmek istediğinize emin misiniz?")) {
                                // Modeldeki entry_details listesinden elemanı sil
                                entryDetailsList.splice(index, 1);

                                // Tabloyu güncelle
                                updateTable();
                            }
                        }
                                // Tabloyu güncelleyen fonksiyon
                        function updateTable() {
                            let tableBody = document.getElementById("entryDetailsBody");
                            tableBody.innerHTML = "";

                            entryDetailsList.forEach((item, i) => {
                                let row = `
                                    <tr data-index="${i}">
                                        <td>${i + 1}</td>
                                        <td>${item.product_id}</td>
                                        <td>${item.quantity}</td>
                                        <td>
                                            <button onclick="deleteEntryDetail(${i})">Sil</button>
                                        </td>
                                    </tr>
                                `;
                                tableBody.innerHTML += row;
                            });
                        }




    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("addRowBtn").addEventListener("click", function (e) {
            e.preventDefault();
            let index = document.querySelectorAll("#productTable tbody tr").length;
            let newRow = `
                <tr>
                    <td>
                        <select class="form-control" name="entry_details[${index}].product_id" required>
                            <option value="">Ürün Seçiniz</option>
    @foreach (var product in ViewBag.products ?? new List<SelectListItem>())
    {
                                                <option value="@product.Value">@product.Text</option>
    }
                        </select>
                    </td>
                    <td><input type="number" class="form-control" name="entry_details[${index}].quantity" required oninput="calculateTotal(this)"/></td>
                    <td><input type="number" step="0.01" class="form-control" name="entry_details[${index}].unit_price" required oninput="calculateTotal(this)"/></td>
                    <td><input type="number" step="0.01" class="form-control" name="entry_details[${index}].total_price" readonly /></td>
                    <td><input type="number" step="0.01" class="form-control" name="entry_details[${index}].weight" required /></td>
                    <td class="text-center"><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Sil</button></td>
                </tr>
            `;
            document.querySelector("#productTable tbody").insertAdjacentHTML("beforeend", newRow);
        });
    });

    function removeRow(button) {
        button.closest("tr").remove();
    }

    function calculateTotal(input) {
        let row = input.closest("tr");
        let quantity = row.querySelector("[name*='quantity']").value;
        let unitPrice = row.querySelector("[name*='unit_price']").value;
        let totalPriceInput = row.querySelector("[name*='total_price']");
        let total = (quantity * unitPrice).toFixed(2);
        totalPriceInput.value = isNaN(total) ? "" : total;
    }
</script>

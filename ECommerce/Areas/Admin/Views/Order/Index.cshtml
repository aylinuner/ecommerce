@using ecommerce.Models.View

<div class="text-center">
    @Html.ActionLink("Yeni", "Save", "Order", null, new { @class = "btn btn-primary" })
</div>

<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Sipariş id</th>
            <th>Kullanıcı adı</th>
            <th>Toplam tutar</th>
            <th>Teslimat adresi</th>
            <th>Oluşturulma Tarihi</th>
            <th>Güncellenme Tarihi</th>
            

        </tr>
    </thead>
    <tbody>
        @*   ViewBag içinde ürünler varsa *@
        @if (ViewBag.orders != null)
        {
            @*  ViewBag'daki ürünler içerisinde dön' *@
            foreach (order item in ViewBag.orders)
            {
                <tr class="order-row" data-id="@item.id">
                    <td class="">@item.id</td>
                    <td class="">@item.user.name @item.user.surname</td>
                    <td class="">@item.product.price</td>
                    <td class="">@item.address</td>
                    <td class="">@item.create_date</td>
                    <td class="">@item.update_date</td>
                </tr>
            }
        }
    </tbody>
</table>
<script>
   
       document.addEventListener("DOMContentLoaded", function () {
         document.querySelectorAll(".order-row").forEach(row => {
             row.addEventListener("dblclick", function () {
                    var orderId = this.getAttribute("data-id");
                 window.location.href = "/Admin/Order/Save?id=" + orderId;
             });
         });
    });
</script>














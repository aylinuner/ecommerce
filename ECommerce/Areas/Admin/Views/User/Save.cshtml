@using ecommerce.Models.Custom
@using ecommerce.Models.View
@model ecommerce.Models.View.AppUserViewModel
@{
    var roles = ViewBag.Roles as List<SelectListItem>;
}


<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <!-- Sol taraf: inputlar -->
        <div class="col-6">
            <div class="mb-3 row">
                <label asp-for="UserName" class="form-label col-form-label col-4">Kullanıcı Adı</label>
                <div class="col-8">
                    <input asp-for="UserName" class="form-control" />
                </div>
            </div>

            <div class="mb-3 row">
                <label asp-for="Email" class="form-label col-form-label col-4">E-posta</label>
                <div class="col-8">
                    <input asp-for="Email" class="form-control" />
                </div>
            </div>

            <div class="mb-3 row">
                <label asp-for="PhoneNumber" class="form-label col-form-label col-4">Telefon Numarası</label>
                <div class="col-8">
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
            </div>
        </div>

        <!-- Sağ taraf: roller tablo şeklinde -->
        <div class="col-6">
            <div class="mb-3 row">
                <div class="col-8">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>ROLLER</th>
                                <th><button class="btn btn-primary">Yeni</button></th> <!-- Buton kısmı -->
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.Roles ?? new List<RoleViewModel>())
                            {
                                <tr>
                                    <td>@role.RoleName</td>
                                    <td class="text-center" style="width:60px">
                                        <button type="button" onclick="deleteRole('1','2')" class="btn btn-danger btn-sm" style="width:50px">Sil</button>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>


@if (ViewBag.Errors != null)
{
    <ul class="text-danger mt-3">
        @foreach (var error in ViewBag.Errors)
        {
            <li>@error</li>
        }
    </ul>
}
<script>
    <script>
      function deleteRole(userId, roleId) {
          if (confirm("Bu rolü silmek istediğinize emin misiniz?")) {
              const url = `/User/DeleteUserRole?userId=${encodeURIComponent(userId)}&roleId=${encodeURIComponent(roleId)}`;

              fetch(url, {
                  method: 'GET'
              })
              .then(response => {
                  if (response.ok) {
                      alert("Silme işlemi başarılı.");
                      location.reload();
                  } else {
                      alert("Silme işlemi başarısız.");
                  }
              })
              .catch(error => {
                  console.error("Hata oluştu:", error);
                  alert("Sunucu hatası.");
              });
          }
      }
</script>


</script>





@using ecommerce.Models.View


<div class="text-center">
    @Html.ActionLink("Yeni", "Save", "Product", null, new { @class = "btn btn-primary" })
</div>
<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Fotoğraf</th>
            <th>Adı</th>
            <th>Kodu</th>
            <th>Açıklama</th>
            <th>Fiyat</th>
            <th>Oluşturulma Tarihi</th>
            
        </tr>
    </thead>
    <tbody>
        @*   ViewBag içinde ürünler varsa *@
        @if (ViewBag.products != null)
        {
            @*  ViewBag'daki ürünler içerisinde dön' *@
            foreach (product item in ViewBag.products)
            {
                <tr class="product-row" data-id="@item.id">
                    <td class="">
                        <a href="@item.image_url" target="_blank">
                            <img src="@item.image_url" alt="@item.name" height="70" />
                        </a>
                    </td>
                    <td class="">@item.name</td>
                    <td class="">@item.code</td>
                    <td class="">@item.description</td>
                    <td class="">@item.price</td>
                    <td class="">@item.create_date</td>
                   
                </tr>
            }
        }
    </tbody>
</table>
<script>
 document.addEventListener("DOMContentLoaded", function () {
         document.querySelectorAll(".product-row").forEach(row => {
             row.addEventListener("dblclick", function () {
                    var productId = this.getAttribute("data-id");
                 window.location.href = "/Admin/product/Save?id=" + productId;
             });
         });
    });
    </script>
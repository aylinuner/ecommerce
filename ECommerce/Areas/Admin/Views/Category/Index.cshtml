@using ecommerce.Models.View


<div class="text-center">
    @Html.ActionLink("Yeni", "Save", "Category", null, new { @class = "btn btn-primary" })
</div>

<table class="table table-striped table-bordered mt-3">

    <thead class="table-dark">

        <tr>

            <th>Adı</th>
            <th>Sıra Numarası</th>
            <th>Güncellenme Tarihi</th>
            <th>Oluşturulma Tarihi</th>
        </tr>
    </thead>
    <tbody>
        @*   ViewBag içinde kategoriler varsa *@
        @if (ViewBag.categories != null)
        {
            @*  ViewBag'daki kategoriler içerisinde dön' *@
            foreach (Category item in ViewBag.categories)
            {
                <tr class="category-row" data-id="@item.Id">
                    <td class="">@item.Name</td>
                    <td class="">@item.SortNo</td>
                    @* <td class="">@item.category_name</td> *@
                    <td class="">@item.UpdateDate</td>
                    <td class="">@item.CreateDate</td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
             document.addEventListener("DOMContentLoaded", function () {
         document.querySelectorAll(".category-row").forEach(row => {
             row.addEventListener("dblclick", function () {
                    var categoryId = this.getAttribute("data-id");
                 window.location.href = "/Admin/category/Save?id=" + categoryId;
             });
         });
    });
    </script>
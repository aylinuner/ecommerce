@using ecommerce.Models.View
@model EntryViewModel

<div class="container mt-5">
    <h2 class="mb-4">Stok Giriş</h2>
    <form method="post" action="/Admin/Entry/Save">
        <input type="text" id="id" asp-for="Id" hidden>
        <div class="mb-3 row">
            <label for="WaybillNo" class="col-sm-2 col-form-label">İrsaliye No:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="WaybillNo" placeholder="İrsaliye no girin" asp-for="WaybillNo">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="WaybillDate" class="col-sm-2 col-form-label">İrsaliye Tarihi:</label>
            <div class="col-sm-10">
                <input type="date" class="form-control" id="WaybillDate" asp-for="WaybillDate">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="SupplierId" class="col-sm-2 col-form-label">Tedarikçi Firma:</label>
            <div class="col-sm-10">
                <select class="form-control" id="SupplierId" asp-for="SupplierId">
                    <option value="">Seçiniz</option>
                    @foreach (var supplier in ViewBag.suppliers ?? new List<SelectListItem>())
                    {
                        <option value="@supplier.Value">@supplier.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3 row">
            <label for="WaybillTotal" class="col-sm-2 col-form-label">İrsaliye Tutarı</label>
            <div class="col-sm-10">
                <input type="number" step="0.01" class="form-control" id="WaybillTotal" placeholder="İrsaliye tutarını girin" asp-for="WaybillTotal">
            </div>
        </div>

        <div class="mb-3 row">
            <label for="ReceiverId" class="col-sm-2 col-form-label">Teslim Alan Kişi</label>
            <div class="col-sm-10">
                <select class="form-control" id="ReceiverId" asp-for="ReceiverId">
                    <option value="">Seçiniz</option>
                    @foreach (var user in ViewBag.users ?? new List<SelectListItem>())
                    {
                        <option value="@user.Value">@user.Text</option>
                    }
                </select>
            </div>
        </div>

        <hr />

        <table class="table table-striped table-bordered mt-3" id="productTable">
            <thead class="table-dark">
                <tr>
                    <th>Ürün Adı</th>
                    <th>Adet</th>
                    <th>Birim Fiyat</th>
                    <th>Toplam Tutar</th>
                    <th>Ağırlık</th>
                </tr>
            </thead>
            <tbody id="entryDetailsBody">

                @for (var i = 0; i < Model.EntryDetails.Count; i++)
                {
                    <tr class="entry_detail-row" data-id="@Model.EntryDetails[i].Id" ondblclick="dblclick">
                        <td>
                            @Model.EntryDetails[i].Stock.Name
                            <input type="hidden" name="EntryDetails[@i].StockId" value="@Model.EntryDetails[i].StockId" />

                            <input type="hidden" name="EntryDetails[@i].id" value="@Model.EntryDetails[i].Id" />
                        </td>

                        <td>
                            @Model.EntryDetails[i].Quantity
                            <input type="hidden" name="EntryDetails[@i].Quantity" value="@Model.EntryDetails[i].Quantity" class="form-control" />
                        </td>
                        <td>
                            @Model.EntryDetails[i].Amount
                            <input type="hidden" step="0.01" name="EntryDetails[@i].Amount" value="@Model.EntryDetails[i].Amount" class="form-control" />
                        </td>
                        <td>
                            @Model.EntryDetails[i].TotalAmount
                            <input type="hidden" step="0.01" name="EntryDetails[@i].TotalAmount" value="@Model.EntryDetails[i].TotalAmount" class="form-control" />
                        </td>
                        <td>
                            @Model.EntryDetails[i].Weight
                            <input type="hidden" step="0.01" name="EntryDetails[@i].Weight" value="@Model.EntryDetails[i].Weight" class="form-control" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mb-3 row">
            <div class="col-sm-10 offset-sm-2">
                @Html.ActionLink("Geri", "Index", "Entry", new { area = "Admin" }, new { @class = "btn btn-dark text-white" })
                <button type="button" class="btn btn-success" id="newProductButton" data-bs-toggle="modal" data-bs-target="#EntryDetailModal">
                    Yeni Ürün Ekle
                </button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </div>
    </form>
</div>

<!-- Ürün Ekle Modal -->
<div class="modal fade" id="EntryDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ürün ekle / Güncelle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body ">
                <form id="EntryDetailForm">
                    <input type="hidden" id="EntryDetailId">

                    <div class="mb-3">
                        <label class="form-label">Ürün</label>
                        <select class="form-control" id="StockSelect">
                            <option value="">Ürün Seçiniz</option>
                            @foreach (var stock in ViewBag.stocks ?? new List<SelectListItem>())
                            {
                                <option value="@stock.Value">@stock.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adet</label>
                        <input type="number" class="form-control" id="Quantity" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Birim Fiyat</label>
                        <input type="number" step="0.01" class="form-control" id="Amount" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ağırlık</label>
                        <input type="number" step="0.01" class="form-control" id="Weight" required>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="saveEntryDetail()">Kaydet</button>
                    <button type="button" class="btn btn-danger" onclick="deleteProductToTable()">Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>



<script>
        document.addEventListener("dblclick", function (event) {
        var row = event.target.closest(".EntryDetail-row");
        if (row) {
            var entryDetailId = row.getAttribute("data-id");

            // AJAX ile entry_detail bilgilerini al
            fetch(`/Admin/Entry/GetProductById?id=${entryDetailId}`)
                .then(response => response.json())
                .then(data => {
                    if (data) {
                        document.getElementById("EntryDetailId").value = data.Id;
                        document.getElementById("StockId").value = data.StockId;
                        document.getElementById("Quantity").value = data.Quantity;
                        document.getElementById("Amount").value = data.Amount;
                        document.getElementById("Weight").value = data.Weight;
                    }

                    // Modalı aç
                    var modal = new bootstrap.Modal(document.getElementById('EntryDetailModal'));
                    modal.show();
                })
                .catch(error => console.error("Veri alınırken hata oluştu:", error));
        }
    });

    // "Yeni Ürün Ekle" butonuna basılınca boş modal aç
    document.getElementById("newProductButton").addEventListener("click", function () {
        document.getElementById("EntryDetailId").value = "";
        document.getElementById("StockId").value = "";
        document.getElementById("Quantity").value = "";
        document.getElementById("Amount").value = "";
        document.getElementById("Weight").value = "";

        var modal = new bootstrap.Modal(document.getElementById('EntryDetailModal'));
        modal.show();
    });

        function saveEntryDetail() {
        let StockSelect = document.getElementById("StockSelect");
        let Quantity = document.getElementById("Quantity").value;
        let Amount = document.getElementById("Amount").value;
        let TotalAmount = (Quantity * Amount).toFixed(2);
        let Weight = document.getElementById("Weight").value;

        if (!StockSelect.value || Quantity <= 0 || Amount <= 0 || Weight <= 0) {
            alert("Lütfen tüm alanları doğru şekilde doldurun!");
            return;
        }

        let tableBody = document.getElementById("entryDetailsBody");
        if (!tableBody) {
            alert("Tablo bulunamadı!");
            return;
        }

        let index = tableBody.rows.length;

         let newRow = `
    <tr>
        <td>${StockSelect.options[StockSelect.selectedIndex].text}
            <input type="hidden" name="EntryDetails[${index}].StockId" value="${StockSelect.value}" />
        </td>
        <td>${Quantity}
            <input type="hidden" name="EntryDetails[${index}].Quantity" value="${Quantity}" />
        </td>
        <td>${Amount}
            <input type="hidden" name="EntryDetails[${index}].Amount" value="${Amount}" />
        </td>
        <td>${TotalAmount}
            <input type="hidden" name="EntryDetails[${index}].TotalAmount" value="${TotalAmount}" />
        </td>
        <td>${Weight}
            <input type="hidden" name="EntryDetails[${index}].Weight" value="${Weight}" />
        </td>
    </tr>
    `;

        tableBody.insertAdjacentHTML("beforeend", newRow);

        document.getElementById("EntryDetailForm").reset();

        let modalElement = document.getElementById('EntryDetailModal');
        let modalInstance = bootstrap.Modal.getInstance(modalElement);
        if (modalInstance) modalInstance.hide();
    }


   

</script>

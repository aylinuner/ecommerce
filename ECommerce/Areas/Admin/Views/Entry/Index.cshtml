@using ecommerce.Models.View


<div class="text-center">
    @Html.ActionLink("Yeni", "Save", "Entry", null, new { @class = "btn btn-primary" })
</div>

<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>İrsaliye Numarası</th>
            <th>İrsaliye Tarihi</th>
            <th>Tedarikçi Firma</th>
            <th>İrsaliye Tutarı</th>
        </tr>
    </thead>
    <tbody>
        @*   @*   ViewBag içinde stok giriş detay varsa *@
        @if (ViewBag.entry_masters != null)
        {
            @*  ViewBag'daki stok giriş içerisinde dön' *@
            foreach (EntryMaster item in ViewBag.entry_masters)
            {
                 <tr class="entry-row" data-id="@item.Id">
                   
                    <td class="">@item.WaybillNo</td>
                    <td class="">@item.WaybillDate</td>
                    <td class="">@item.SupplierId</td>
                    <td class="">@item.WaybillTotal</td>
                    @* <td class="">@item.create_date</td> *@
                </tr>
            }
        }
    </tbody>
</table>
<script>
    document.addEventListener("DOMContentLoaded", function () {
         document.querySelectorAll(".entry-row").forEach(row => {
             row.addEventListener("dblclick", function () {
                 var entryId = this.getAttribute("data-id");
                 window.location.href = "/Admin/Entry/Save?id=" + entryId;
             });
         });
     });
 </script>
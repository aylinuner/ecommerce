@using ecommerce.Models.View


<div class="text-center">
    @Html.ActionLink("Yeni", "Save", "Customer", null, new { @class = "btn btn-primary" })
</div>
<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Adı</th>
            <th>Soyadı</th>
            <th>Müşteri Rolü</th>
            @* <th>Telefon Alan kodu</th> *@
            <th>Telefon Numarası</th>
            <th>Cinsiyet</th>
            <th>Doğum Tarihi</th>
            <th>Kayıt Tarihi</th>
           @*  <th>E posta</th>
            <th>Parola</th> *@

            
        </tr>
    </thead>
    <tbody>
        @*   ViewBag içinde müşteriler varsa *@
        @if (ViewBag.customers != null)
        {
            @*  ViewBag'daki müşteriler içerisinde dön' *@
            foreach (Customer item in ViewBag.customers)
            {
                <tr class="customer-row" data-id="@item.Id">
                    <td class="">@item.Name</td>
                    <td class="">@item.Surname</td>
                    <td class="">@item.Type</td>
                    @* <td class="">@item.type</td> *@
                    @* <td class="">@item.phone_area</td> *@
                    <td class="">@item.PhoneNumber</td>
                    <td class="">@item.Gender</td>
                    <td class="">@item.BirthDate</td>
                     <td class="">@item.SaveDate</td> 
                   @*  <td class="">@item.email</td>
                    <td class="">@item.password</td> *@
                    
                </tr>
            }
        }
    </tbody>
</table>
<script>
    document.addEventListener("DOMContentLoaded", function(){
        document.querySelectorAll(".customer-row").forEach(row =>{
            row.addEventListener("dbclick",function(){
                var customerId= this.getAttribute("data-id");
                 window.location.href = "/Admin/customer/Save?id=" + customerId;
            });
         });
    });

</script>














@using ecommerce.Models.Custom
@using ecommerce.Models.View

<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Adı</th>
            <th>Soyadı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.AppUserProfile != null)
        {
            foreach (AppUserProfile item in ViewBag.AppUserProfile)
            {
                <tr class="customer-row" data-id="@item.Id">
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>
                        <button class="btn btn-danger btn-sm delete-btn" data-id="@item.Id">Sil</button>
                        <button class="btn btn-primary btn-sm update-btn" data-id="@item.Id">Güncelle</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        // Silme işlemi
        $('.delete-btn').click(function () {
            var id = $(this).data('id');
            if (confirm("Bu kullanıcıyı silmek istediğinize emin misiniz?")) {
                $.ajax({
                    url: '/User/Delete',
                    type: 'POST',
                    data: { id: id },
                    success: function () {
                        location.reload(); // Sayfayı yenileyerek güncel tabloyu göster
                    },
                    error: function () {
                        alert("Silme işlemi başarısız.");
                    }
                });
            }
        });

        // Güncelleme işlemi için örnek
        $('.update-btn').click(function () {
            var id = $(this).data('id');
            // Burada modalle form açabilir veya direkt bir işlem yapabilirsin
            alert("Güncelleme için ID: " + id); // geçici
            // Örnek: $('#updateModal').modal('show');
        });
    });
</script>



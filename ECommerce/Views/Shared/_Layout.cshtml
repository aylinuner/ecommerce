@using Microsoft.AspNetCore.Identity
@using ecommerce.Models.Custom
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager //userın bilgilerine ulaşmak için

@* websitenin tüm içerik sayfalarının bu sayfa kendi içersinde gösterir bir resmin çerçevesi gibidir *@
@{
    var userx = await UserManager.GetUserAsync(User); //oturum açmış kullanıcı bilgilerini getir
    var email = userx?.Email;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nera - E-Ticaret</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="//code.jivosite.com/widget/H5HKBPvNwZ" async></script>


    <style>

        /* Filtre kutuları için stil */
        .filter-box {
            max-height: 150px; /* Maksimum yükseklik */
            overflow-y: auto; /* Dikey kaydırma çubuğu */
            border: 1px solid #ddd;
            padding: 10px;
            background-color: #f9f9f9;
        }

        .thumbnail-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
        }

        .thumbnail img {
            width: 80px;
            height: 50px;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.3s;
        }

            .thumbnail img:hover {
                opacity: 1;
            }
    </style>
</head>
<body class="bg-light">
    <header>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-dark" href="/Home/Index">
                    <img src="https://www.vatanbilgisayar.com/assets/dist/images/sitelogo.svg" alt="Logo" width="100" height="50" class="d-inline-block align-text-top">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <!-- Arama Çubuğu -->
                        <li class="nav-item">
                            <form method="get" action="@Url.Action("Index", "Home")" class="d-flex w-100">
                                <div class="input-group" style="width:600px; height=:50px">
                                    <input type="text" class="form-control rounded-start-3" placeholder="Ürün Ara" name="searchTerm" />
                                    <button class="btn btn-outline-dark rounded-end-3" type="submit">
                                        <i class="bi bi-search">Ara</i>
                                    </button>
                                </div>
                            </form>
                        </li>
                    </ul>

                    <div class="d-flex">
                        @if (!SignInManager.IsSignedIn(User))
                        { 
                            @Html.ActionLink("Giriş Yap", "Login", "User", null, new { @class = "btn btn-outline-dark me-2" })


                        <a href="/Admin/Category/Index" class="btn btn-dark me-2">Admin Girişi</a>
                        <a href="/UserPanel/Membership" class="btn btn-dark">
                            Kullanıcı
                        </a>
                        }
                    </div>
                </div>
            </div>
            @if (SignInManager.IsSignedIn(User))
            {
                <form asp-controller="User" asp-action="Logout" method="post">
                    @{
                        var user = await UserManager.GetUserAsync(User); // Oturum açmış kullanıcıyı alıyoruz.
                        if (user != null && !await UserManager.IsInRoleAsync(user, "Customer")) // kullanıcı rollerinde customer diye bir rol yoksa navbarda admin paneline geçiş butonunu göster.
                        {
                            @Html.ActionLink("Admin", "Index", "Home", new { area = "Admin" }, new { @class = "btn btn-dark" })

                        }

                    }
                    <a href="/UserPanel/Membership" type="button" class="btn btn-dark">

                        @* bootstrap sitesinden kullanıcı iconu kulalndım *@
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                        </svg>
                        @user.UserName
                        @* @firstName *@

                            </a>
                    <button type="submit" class="btn btn-dark">
                        <i class="fas fa-sign-out-alt"></i>
                        Çıkış
                    </button>
                </form>
            }
            

        </nav>
        @* Url'deki controller bilgisi UserPanel ve User değilse kategori componentini ekranda göster. Kategoriler kısmı user ve userpanelde ekranda gösterme' *@
        @if (
        !(ViewContext.RouteData.Values["controller"]?.ToString() == "UserPanel")
        && !(ViewContext.RouteData.Values["controller"]?.ToString() == "User")
        )
        {
            <div class="container d-flex justify-content-center mt-3">
                @await Component.InvokeAsync("CategoryMenu")
            </div>
        }

    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - ecommerce - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<div class="container mt-4">
    <div class="row">
        <!-- Sepet Ürünleri -->
        <div class="col-10">
            <div class="card p-3">
                <h2 class="mb-3">Sepetteki Ürünler</h2>
                @if (ViewBag.baskets != null)
                {
                    @foreach (var item in ViewBag.baskets)
                    {
                        <div class="cart-item d-grid align-items-center border-bottom py-2" style="grid-template-columns: 60px 1fr 120px 120px 50px; gap: 10px;">
                            <img src="@item.product.image_url" alt="@item.product.name" class="img-fluid" style="width: 50px; height: 50px;">
                            <span>@item.product.name</span>
                            <span>@item.product.price.ToString("0.00") TL</span>

                            <div class="quantity d-flex align-items-center">
                                <button class="btn btn-outline-secondary btn-sm" onclick="decreaseQuantity(this)">-</button>
                                <input type="text" class="form-control text-center mx-2" value="@item.quantity" readonly style="width: 50px;">
                                <button class="btn btn-outline-secondary btn-sm" onclick="increaseQuantity(this)">+</button>
                            </div>
                            <button class="btn btn-danger btn-sm" onclick="removeItem(this)"><i class="fas fa-trash">Sil</i></button>
                        </div>
                    }
                }
            </div>
        </div>
        <!-- Sipariş Özeti -->
        <div class="col-2">
            <div class="card p-3">
                <h4 class="mb-3">Sipariş Özeti</h4>

                <div class="d-flex justify-content-between">
                    <span>Ara Toplam:</span>
                    <span id="subtotal" class="text-end">
                        @*  @(item.basket != null && Model.basketItems.Any() ?
                            Model.basketItems.Sum(x => x.amount * x.quantity).ToString("0.00") : "0.00") TL *@
                    </span>
                </div>

                <div class="d-flex justify-content-between">
                    <span>KDV:</span>
                    <span id="tax" class="text-end">0 TL</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between">
                    <strong>Toplam:</strong>
                    <strong id="total" class="text-end">
                        @*  @(Model.basketItems != null && Model.basketItems.Any() ?
                            Model.basketItems.Sum(x => x.Price * x.Quantity).ToString("0.00") : "0.00") TL *@
                    </strong>
                </div>

                <a href="/Order/Delivery" class="btn btn-outline-primary mt-3 w-100">Sepeti Onayla</a>
            </div>
        </div>
    </div>
</div>

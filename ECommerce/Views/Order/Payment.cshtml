<div class="container mt-5">
    <div class="row">
        <!-- Banka Seçimi -->
        <div class="col-md-7">
            <div class="card p-4">
                <h5 class="mb-3">Havale yapmak istediğiniz bankayı seçerek devam edin</h5>
                <form>
                    @if (ViewBag.banks != null)
                    {
                        @foreach (var item in ViewBag.banks)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="banka" id="@item.id" value="@item.id" @* @(item.id == "garanti" ? "checked" : "") *@>
                                <label class="form-check-label" for="@item.id">@item.name</label>
                            </div>
                        }
                    }
                </form>

            </div>
        </div>


        <!-- Sipariş Özeti -->
        <div class="col-md-5">
            <div class="card p-4">
                <h5>Sipariş Özeti</h5>
                <p>Ara Toplam: <strong>38.165,83 TL</strong></p>
                <p>KDV: <strong>7.633,17 TL</strong></p>
                <p>Kargo: <strong>Bedava</strong></p>
                <h4 class="text-primary">Toplam: 45.799,00 TL</h4>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="sozlesme">
                    <label class="form-check-label" for="sozlesme">
                        <a href="#">Ön Bilgilendirme Formunu</a> ve <a href="#">Satış Sözleşmesini</a> okudum ve kabul ediyorum.
                    </label>
                </div>
                <button class="btn btn-primary w-100">Siparişi Onayla</button>
            </div>
        </div>
    </div>
</div>

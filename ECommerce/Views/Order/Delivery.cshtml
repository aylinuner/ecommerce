@{
    int selectedAddressId = ViewBag.SelectedAddressId ?? 0; // Eğer ViewBag null ise varsayılan 0 olacak
}
<div class="container mt-4">
    <div class="row">
        <!-- Sol Bölüm - Teslimat Adresi ve Kargo -->
        <div class="col-md-8">
            <div class="card p-3 mb-3">
                <h5 class="fw-bold">Teslimat Adresi</h5>
                <div class="row">
                    <div class="col-md-6">
                            <div class="border p-3 text-center">
                                <span class="fw-bold">+</span>
                                <p>Yeni adres ekle</p>
                            </div>
                        </div>

                        @if (ViewBag.user_addresses != null)
                        {


                            @foreach (var address in ViewBag.user_addresses)
                            {
                                <div class="col-md-6">
                                    <div class="border p-3">
                                        <input type="radio" name="selectedAddress" value="@address.id" @(address.id == selectedAddressId ? "checked" : "")>
                                        <span class="fw-bold">@address.name</span>
                                        <p class="m-0">@address.address</p>
                                        <p class="fw-bold">@address.city.name / @address.district.name</p>
                                        <a href="#">Düzenle</a> | <a href="#">Sil</a>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>


                <div class="card p-3">
                    <h5 class="fw-bold">Teslimat</h5>
                    @if (ViewBag.delivery_types != null)
                    {
                        @foreach (var dt in ViewBag.delivery_types)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="kargo" value="@dt.id" @* @(dt.IsDefault ? "checked" : "") *@>
                                <label class="form-check-label">
                                    @dt.name
                                    <span class="@(dt.price == 0 ? "text-success" : "text-danger")">
                                        @(dt.price == 0 ? "Ücretsiz" : dt.price.ToString("N2") + " TL")
                                    </span>
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>


            <!-- Sağ Bölüm - Sipariş Özeti -->
            <div class="col-md-4">
                <div class="card p-3">
                    <h5 class="fw-bold">Sipariş Özeti</h5>
                    <p>Ara Toplam: <span class="float-end">38.165,83 TL</span></p>
                    <p>KDV: <span class="float-end">7.633,17 TL</span></p>
                    <p>Kargo: <span class="float-end text-success">Bedava</span></p>
                    <h5 class="fw-bold text-primary">TOPLAM: <span class="float-end">45.799,00 TL</span></h5>
                    <a href="/Order/Payment" class="btn btn-primary w-100 mt-3">Teslimatı Onayla &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

@using ecommerce.Models.View
@model StockMasterViewModel

<div class="container mt-4">
    <div class="row">
        <!-- Ürün Resim Alanı -->
        <div class="col-md-6">
            <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item ">
                        <img src="@Model.ImageUrl" class="d-block w-100" alt="Product Image">
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>

            <!-- Küçük Resimler -->
            <div class="mt-3 d-flex justify-content-center">
                <img src="@Model.ImageUrl" class="img-thumbnail mx-1" style=" height: 400px; cursor: pointer;" onclick="changeImage('@Model.ImageUrl')">
            </div>
        </div>

        <!-- Ürün Bilgi Alanı -->
        <div class="col-md-6">
            <h4>@Model.Name</h4>
           @*  <p><strong>@Model.Price TL</strong></p>
            <p>@Model.Description</p> *@

            <a href="@Url.Action("AddToBasket", "Basket", new { id = Model.Id })" class="btn btn-primary">
                Sepete Ekle
            </a>


            <div class="mt-3">
                <p><strong>Ek Garanti İster Misiniz?</strong></p>
                <button class="btn btn-outline-primary w-100">+1 Yıl Ek Garanti </button>
            </div>

            <div class="mt-4">
                <p><strong>Birlikte Alabileceğiniz Ürünler:</strong></p>
                @if (ViewBag.stocks != null)
                {


                    @foreach (var item in ViewBag.stocks)
                    {
                        <div class="d-flex justify-content-between align-items-center border p-2 mb-2">
                            <span>@item.Name - <strong>@item.Price TL</strong></span>
                            <button class="btn btn-sm btn-primary">Birlikte Al</button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<script>
    function changeImage(src) {
        document.querySelector("#productCarousel .carousel-item.active img").src = src;
    }
</script>

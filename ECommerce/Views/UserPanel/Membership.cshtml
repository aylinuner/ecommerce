@using ecommerce.Models.Custom
<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="container  d-flex justify-content-center mt-3">
                @await Component.InvokeAsync("UserPanel")
            </div>
        </div>

        <div class="col-md-9">
            <div id="uyelik" class="content">
                <div class="card shadow-sm bg-white p-4">
                    <h3 class="card-title">Üyelik Bilgilerim</h3>
                    <div class="card-body">
                        @{
                            var users = ViewBag.users as List<AppUser>;
                        }

                        @if (users != null)
                        {
                            <div class="form-row d-flex flex-wrap gap-3">
                                @foreach (var user in users)
                                {
                                    <div class="border rounded p-3 m-2 shadow-sm" style="width: 100%;">
                                        <div class="row">
                                            <div class="form-group col-md-4">
                                                <label>Ad Soyad</label>
                                                <input type="text" class="form-control" value="@user.UserName" />
                                            </div>

                                            <div class="form-group col-md-4">
                                                <label>E-Posta</label>
                                                <input type="email" class="form-control" value="@user.Email" />
                                            </div>

                                            <div class="form-group col-md-4">
                                                <label>Telefon</label>
                                                <input type="tel" class="form-control" value="@user.PhoneNumber" />
                                            </div>

                                            <div class="form-group col-md-4">
                                                <label>Şifre</label>
                                                <input type="password" class="form-control" value="@user.PasswordHash" readonly />
                                            </div>

                                            <div class="form-group col-md-4">
                                                <label>Cinsiyet</label><br />
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="gender_@user.Id" value="Erkek" @(user.Gender == "Erkek" ? "checked" : "") />
                                                    <label class="form-check-label">Erkek</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="gender_@user.Id" value="Kadın" @(user.Gender == "Kadın" ? "checked" : "") />
                                                    <label class="form-check-label">Kadın</label>
                                                </div>
                                            </div>

                                            <div class="form-group col-md-4">
                                                <label>Doğum Tarihi</label>
                                                <input type="date" class="form-control" value="@(user.BirthDate?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <button class="btn btn-primary mt-3">Bilgileri Güncelle</button>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>